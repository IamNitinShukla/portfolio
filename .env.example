# =========================================================================
# Nitin Portfolio Assistant — Environment Configuration
# =========================================================================

# Google Gemini API Key (Required for live Gemini assistant responses)
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Flash Model identifier (Default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Server-side rate limit per IP per minute (Default: 25)
GEMINI_RATE_LIMIT_RPM=25

# =========================================================================
# Gmail SMTP & OTP Verification Configuration (Server-Side Only)
# =========================================================================
# 1. Google Account Details:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=snitin.tech@gmail.com
CONTACT_EMAIL=snitin.tech@gmail.com

# 2. Gmail App Password:
# Generate a dedicated 16-character App Password at:
# https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification enabled on your Google account)
# Enter the generated password below without spaces:
SMTP_PASS=your_16_char_gmail_app_password_here

