<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 700" width="600" height="700">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#14161d" />
      <stop offset="100%" stop-color="#07080a" />
    </linearGradient>
    <radialGradient id="faceGlow" cx="50%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#E8FF70" stop-opacity="0.15" />
      <stop offset="100%" stop-color="#000000" stop-opacity="0" />
    </radialGradient>
  </defs>
  <rect width="600" height="700" fill="url(#bgGrad)" />
  <circle cx="300" cy="280" r="220" fill="url(#faceGlow)" />
  
  <!-- Subtle Grid lines -->
  <g opacity="0.08" stroke="#ffffff" stroke-width="1">
    <line x1="0" y1="175" x2="600" y2="175" />
    <line x1="0" y1="350" x2="600" y2="350" />
    <line x1="0" y1="525" x2="600" y2="525" />
    <line x1="150" y1="0" x2="150" y2="700" />
    <line x1="300" y1="0" x2="300" y2="700" />
    <line x1="450" y1="0" x2="450" y2="700" />
  </g>

  <!-- Silhouette & Aesthetic Elements -->
  <g transform="translate(300, 320)">
    <!-- Shoulders -->
    <path d="M-190 260 C-170 170, -110 130, -70 110 C-30 140, 30 140, 70 110 C110 130, 170 170, 190 260 Z" fill="#1b1d24" stroke="#2a2e39" stroke-width="2" />
    <!-- Neck -->
    <path d="M-40 120 L-40 40 L40 40 L40 120 Z" fill="#242731" />
    <!-- Head silhouette -->
    <ellipse cx="0" cy="-40" rx="90" ry="115" fill="#20232c" stroke="#333745" stroke-width="2" />
    <!-- Hair structure -->
    <path d="M-95 -50 C-100 -140, -40 -170, 0 -170 C50 -170, 100 -140, 95 -50 C80 -100, 20 -120, 0 -115 C-30 -120, -75 -100, -95 -50 Z" fill="#13151b" />
    <!-- Stylized glasses / cyber visor -->
    <rect x="-65" y="-55" width="55" height="26" rx="6" fill="#0A0A0A" stroke="#E8FF70" stroke-width="2" />
    <rect x="10" y="-55" width="55" height="26" rx="6" fill="#0A0A0A" stroke="#E8FF70" stroke-width="2" />
    <line x1="-10" y1="-42" x2="10" y2="-42" stroke="#E8FF70" stroke-width="2" />
    <!-- Subtle reflection -->
    <line x1="-50" y1="-50" x2="-25" y2="-35" stroke="#E8FF70" stroke-width="1.5" stroke-linecap="round" opacity="0.6" />
    <line x1="25" y1="-50" x2="50" y2="-35" stroke="#E8FF70" stroke-width="1.5" stroke-linecap="round" opacity="0.6" />
  </g>

  <!-- High-Tech Badge Overlays -->
  <g transform="translate(40, 620)">
    <text font-family="monospace" font-size="12" fill="#E8FF70" letter-spacing="0.15em">SYSTEM: VERIFIED CANDIDATE</text>
    <text y="22" font-family="monospace" font-size="11" fill="#929292" letter-spacing="0.1em">CORE: AI &amp; FULL-STACK ARCHITECTURE</text>
  </g>
</svg>