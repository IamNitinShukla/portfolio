  <path d="M260 220 C220 250, 180 320, 260 380 C340 320, 300 250, 260 220 Z" fill="#2d4a36" stroke="#487857" stroke-width="2" />
  <line x1="260" y1="230" x2="260" y2="370" stroke="#71a983" stroke-width="2" />

  <!-- Audio Waveform Area below -->
  <rect x="55" y="485" width="430" height="130" rx="8" fill="#17241D" stroke="#1D2E24" />
  <text x="75" y="515" font-family="monospace" font-size="12" fill="#E8FF70">VOICE QUERY: Dialect Normalized (Whisper)</text>
  <path d="M80 570 Q120 520, 150 570 T220 570 T290 530 T360 570 T420 550 T460 570" fill="none" stroke="#E8FF70" stroke-width="3" />

  <!-- Right Mandi Price & Analytics -->
  <rect x="540" y="80" width="630" height="565" rx="8" fill="#111A15" stroke="#1D2E24" />
